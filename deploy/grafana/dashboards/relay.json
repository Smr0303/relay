{
 "uid": "relay",
 "title": "Relay",
 "schemaVersion": 39,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Steps completed / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(relay_steps_completed_total[1m]))",
     "legendFormat": "steps/s"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Dispatch latency (ready \u2192 claimed)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(relay_dispatch_latency_seconds_bucket[1m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_dispatch_latency_seconds_bucket[1m])))",
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queue: ready tasks / oldest wait",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (relay_queue_depth)",
     "legendFormat": "ready {{kind}}"
    },
    {
     "refId": "B",
     "expr": "max(relay_oldest_ready_task_seconds)",
     "legendFormat": "oldest ready (s)"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Timers: pending / lag p99 / overdue",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(relay_timers_pending)",
     "legendFormat": "pending"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_timer_lag_seconds_bucket[1m])))",
     "legendFormat": "lag p99 (s)"
    },
    {
     "refId": "C",
     "expr": "max(relay_timers_overdue_seconds)",
     "legendFormat": "oldest overdue (s)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Lease expiries / s (worker deaths, slow steps)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(relay_lease_expiries_total[1m]))",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Step failures / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 7,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (final) (rate(relay_step_failures_total[1m]))",
     "legendFormat": "final={{final}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Runs closed / s by status",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "ops"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (status) (rate(relay_runs_closed_total[1m]))",
     "legendFormat": "{{status}}"
    },
    {
     "refId": "B",
     "expr": "sum(rate(relay_runs_started_total[1m]))",
     "legendFormat": "started"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Replay time p99 / step duration p99",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_replay_seconds_bucket[1m])))",
     "legendFormat": "replay p99"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le) (rate(relay_step_duration_seconds_bucket[1m])))",
     "legendFormat": "step p99"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Parked runs & non-determinism",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(relay_runs_parked_total[5m]))",
     "legendFormat": "parked (5m)"
    },
    {
     "refId": "B",
     "expr": "sum(increase(relay_nondeterminism_total[5m]))",
     "legendFormat": "non-determinism (5m)"
    }
   ]
  }
 ]
}